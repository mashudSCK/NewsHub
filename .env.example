# Demo is explicit in the UI and never calls an external news provider.
NEWS_MODE=demo
# Set NEWS_MODE=live to use GNews. Never use NEXT_PUBLIC_ for secrets.
GNEWS_API_KEY=
NEWS_COUNTRY=us
NEWS_LANGUAGE=en
# Set below your account's actual daily quota; 90 reserves room on the free plan.
NEWS_DAILY_BUDGET=90
# Required for live production. Local development can use in-memory storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only on Vercel, whose platform overwrites x-vercel-forwarded-for.
NEWS_TRUST_VERCEL=false
